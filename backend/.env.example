# App
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database. These DB_* values are for running the backend directly on the
# host against the Dockerized Postgres (port-forwarded to localhost:5432).
# docker-compose.yml overrides DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD/DB_NAME
# for the containerized backend, which reaches Postgres via the "postgres"
# service name instead - keep POSTGRES_* in the root .env.example in sync.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=todo_user
DB_PASSWORD=todo_password
DB_NAME=todo_db
